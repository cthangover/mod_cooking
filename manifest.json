{
  "id": "cooking",
  "name": "Cooking",
  "version": "1.0.0",
  "author": "ct",
  "description": "The kitchen of Cthangover: learn recipes, cook at the home_kitchen workbench and keep an eye on the party's rations.",
  "category": "gameplay",
  "sources": [
    "src/*.cs"
  ],
  "test_sources": [
    "tests/*.cs"
  ],
  "depends": [ "cthangover_game>=1", "ui_base>=1", "items_base>=1", "time_base>=1" ],
  "ui": [
    {
      "id": "cooking_workbench",
      "kind": "overlay",
      "scene": "home_kitchen",
      "slot": "ModLastPanel",
      "scene_path": "scenes/cooking_panel.tscn",
      "once": true,
      "show_on_start": false,
      "priority": 10
    },
    {
      "id": "ration_stats",
      "kind": "overlay",
      "scene": "home_kitchen",
      "slot": "Lastground",
      "scene_path": "scenes/ration_statistics_panel.tscn",
      "once": false,
      "show_on_start": true,
      "priority": 20
    }
  ],
  "test_suites": [
    {"id": "cooking_walk", "activate": ["--itest=cooking_walk"]}
  ]
}
